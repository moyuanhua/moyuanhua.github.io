---
import '@fontsource/geist/400.css';
import '@fontsource/geist/500.css';
import '@fontsource/geist/600.css';
import '@fontsource/geist/700.css';
import '@fontsource/geist-mono/400.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = 'moyuanhua 的个人站：AI Agent 工具与它的思考。',
} = Astro.props;

const BASE = import.meta.env.BASE_URL;
const navLinks = [
  { href: `${BASE}projects`, label: '项目' },
  { href: `${BASE}writing`, label: '文章' },
  { href: `${BASE}about`, label: '关于' },
];
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const norm = href.replace(/\/$/, '') || '/';
  return currentPath === norm || currentPath.startsWith(norm + '/');
};
const year = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={`${BASE}favicon.svg`} sizes="any" />
  </head>
  <body class="bg-bg text-text min-h-screen flex flex-col font-body antialiased">
    <header class="sticky top-0 z-40 bg-bg/85 backdrop-blur-md border-b border-border">
      <nav class="mx-auto max-w-3xl px-6 h-16 flex items-center justify-between gap-4">
        <a
          href={BASE}
          class="font-heading text-base font-semibold tracking-tight text-text hover:text-[var(--color-accent)] transition-colors"
        >
          moyuanhua
        </a>
        <ul class="flex items-center gap-5">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? 'page' : undefined}
                class={`text-sm font-medium transition-colors ${
                  isActive(link.href) ? 'text-text' : 'text-text-muted hover:text-text'
                }`}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>

    <main class="flex-1 w-full">
      <slot />
    </main>

    <footer class="border-t border-border mt-20">
      <div class="mx-auto max-w-3xl px-6 py-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
        <p class="font-mono text-xs text-text-muted">© {year} moyuanhua</p>
        <a
          href="https://github.com/moyuanhua"
          target="_blank"
          rel="noopener noreferrer"
          class="font-mono text-xs text-text-muted hover:text-[var(--color-accent)] transition-colors"
        >
          github.com/moyuanhua
        </a>
      </div>
    </footer>
  </body>
</html>
