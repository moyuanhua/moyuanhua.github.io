---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const BASE = import.meta.env.BASE_URL;
const projects = (await getCollection('projects'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => {
    if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
    return a.data.order - b.data.order;
  });

const statusLabel: Record<string, string> = {
  active: '在做',
  paused: '暂停',
  archived: '归档',
};
---

<BaseLayout title="项目 · moyuanhua" description="moyuanhua 造过的东西：Shopify / AI / Agent。">
  <section class="mx-auto max-w-3xl px-6 pt-20 pb-8">
    <h1 class="font-heading text-4xl sm:text-5xl tracking-tight text-text font-medium">项目</h1>
    <p class="mt-4 text-text-muted max-w-[46ch] leading-relaxed">我造过的东西：Shopify / AI / Agent，以及它们解决的问题。</p>
  </section>

  <section class="mx-auto max-w-3xl px-6 pb-24">
    {projects.length === 0 ? (
      <p class="font-mono text-sm text-text-faint py-16 text-center">尚无项目。</p>
    ) : (
      <ul class="list-none p-0 space-y-4">
        {projects.map((project) => (
          <li>
            <a
              href={`${BASE}projects/${project.id}`}
              class="group block p-6 rounded-[6px] border transition-colors"
              style="background: var(--color-surface); border-color: var(--color-border);"
            >
              <div class="flex items-baseline justify-between gap-3">
                <h2 class="font-heading text-xl text-text group-hover:text-[var(--color-accent)] transition-colors">
                  {project.data.title}
                </h2>
                <span class="shrink-0 font-mono text-[0.65rem] uppercase tracking-wider text-text-faint">
                  {statusLabel[project.data.status] ?? project.data.status}
                </span>
              </div>
              <p class="mt-2 text-text-muted leading-relaxed">{project.data.description}</p>
              {project.data.stack.length > 0 && (
                <p class="mt-3 font-mono text-[0.65rem] uppercase tracking-wider text-text-faint">
                  {project.data.stack.join(' · ')}
                </p>
              )}
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
